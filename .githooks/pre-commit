#!/bin/sh
# Blocks any commit that would publish the private secrets file or an API key.
# Turn on once per clone:  git config core.hooksPath .githooks

if git diff --cached --name-only | grep -qE '(^|/)(secrets\.toml|\.env)$'; then
  echo "BLOCKED: a secrets file is staged. It must never be committed." >&2
  exit 1
fi

# Added lines that look like a key or access code, ignoring the placeholders in secrets.toml.example.
if git diff --cached -U0 | grep -E '^\+' \
   | grep -E 'AIza[0-9A-Za-z_-]{30,}|AQ\.[0-9A-Za-z_.-]{30,}|sk-ant-[0-9A-Za-z_-]{20,}|(API_KEY|ACCESS_CODE)[[:space:]]*=[[:space:]]*"[^"]{8,}"' \
   | grep -vqE 'your-key-from-aistudio|choose-a-code'; then
  echo "BLOCKED: this commit contains what looks like an API key or access code." >&2
  echo "Keep keys only in .streamlit/secrets.toml or the host's secrets settings." >&2
  exit 1
fi
exit 0

# Copy this file to secrets.toml (never commit that file) and fill in your own values,
# or run:  pyw set_secrets.py --window
GEMINI_API_KEY = "your-key-from-aistudio.google.com"

# Works on Gemini's free tier. Larger models may be busy or need a paid tier.
GEMINI_MODEL = "gemini-3.5-flash-lite"

# Optional guards for a public link. Share ACCESS_CODE only with reviewers.
ACCESS_CODE = "choose-a-code"
DAILY_LIMIT = 20
